# Persistent local overrides for VisionForge (non-secret).
# Copy to .env and adjust if needed. Never put tokens here.

# All heavy caches MUST stay on D: — C: is near full.
PIP_CACHE_DIR=D:/caches/pip
HF_HOME=D:/caches/huggingface
HUGGINGFACE_HUB_CACHE=D:/caches/huggingface/hub
TORCH_HOME=D:/caches/torch
TEMP=D:/caches/tmp
TMP=D:/caches/tmp

# Artifact roots (ignored by git)
VISIONFORGE_ARTIFACTS_DIR=D:/project/artifacts
VISIONFORGE_SAM3_SRC=D:/caches/sam3_src

# Optional local model package overrides (directories, relative or absolute)
# VISIONFORGE_SAM31_DIR=models/sam31
# VISIONFORGE_EDGETAM_DIR=models/edgetam
# VISIONFORGE_DINOV3_DIR=models/dinov3-vits16
# VISIONFORGE_MOBILECLIP2_DIR=models/mobileclip2-s0
